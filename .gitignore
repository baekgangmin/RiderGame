# OS 관련
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Unity3D Generated File On Crash Reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# 크래시 리포트
crashlytics-build.properties

# Packages 잠금 파일은 버전 관리에 포함하는 것을 권장 (Packages/packages-lock.json)
